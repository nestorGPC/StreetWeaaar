# =============================================================================
# StreetWear CR - Entorno de producción para alwaysdata (PLANTILLA)
# =============================================================================
# Copia este archivo al servidor como `.env` (NUNCA lo subas a Git) y reemplaza:
#   - USUARIO       por el nombre real de tu cuenta alwaysdata
#   - (la APP_KEY se genera en el servidor con: php artisan key:generate)
#
# Este archivo NO contiene secretos reales. Es únicamente una plantilla.
#
# Ruta típica del proyecto en alwaysdata:
#   /home/USUARIO/www/streetwear
# La raíz web del sitio apunta a:
#   /home/USUARIO/www/streetwear/public
# =============================================================================

APP_NAME="StreetWear CR"

# Producción: NUNCA dejar debug habilitado
APP_ENV=production
APP_KEY=                          # -> php artisan key:generate en el servidor
APP_DEBUG=false
APP_URL=https://USUARIO.alwaysdata.net

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- SQLite (requisito académico del proyecto) ------------------------------
DB_CONNECTION=sqlite
# Ruta ABSOLUTA al archivo SQLite dentro del proyecto en alwaysdata.
# Debe existir y ser escribible por el usuario del hosting.
DB_DATABASE=/home/USUARIO/www/streetwear/database/database.sqlite

# --- Sesiones ----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies seguras SOLO via HTTPS (obligatorio en producción)
SESSION_SECURE_COOKIE=true

# --- Colas y caché -----------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Redis NO se usa en este proyecto ---------------------------------------
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- Correo (modo demo: no se envían correos reales) -------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Servicios externos (NO se usan en la demo) ------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
